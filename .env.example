# Copy to .env in this directory for docker-compose to pick up automatically.
# Every value below is optional -- `docker compose up` works with none of
# this set; the AI layer just stays "not configured" until you add a key.

POSTGRES_PASSWORD=collabos
JWT_SECRET=

# See ai-service/.env.example for provider notes (tested against Groq's free tier).
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
