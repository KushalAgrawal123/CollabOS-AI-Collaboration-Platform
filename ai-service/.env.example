# Copy to .env and fill in only if you want the AI features. Everything else
# in CollabOS works with none of this set — ask/summarize just report
# "not configured" until you do.

DATABASE_URL=postgresql://collabos:collabos@localhost:5432/collabos
UPLOADS_DIR=../backend/uploads
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Any OpenAI-compatible chat endpoint works here — this has been tested against
# Groq's free tier (https://console.groq.com, no cost), but OpenRouter, Together,
# a local Ollama server, or real OpenAI all work by changing these three values
# and nothing else in the code.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
